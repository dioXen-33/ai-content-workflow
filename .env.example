# ============================================================================
#  Workflow IA - Configuration
#  Copier ce fichier en `.env` et remplir les valeurs.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend de scraping
# ---------------------------------------------------------------------------
# `apify` : API payante, robuste, sans session personnelle. A privilegier sur un
#           serveur : les plateformes bloquent vite les adresses de datacenter.
# `ytdlp` : gratuit, mais Instagram exige une session capturee depuis le
#           navigateur dedie (Parametres > Navigateur de scraping).
# Pinterest passe toujours par yt-dlp, quel que soit ce reglage.
SCRAPER_BACKEND=apify

# Navigateur Chromium utilise pour la capture de session. Detecte
# automatiquement (Chrome, Edge, Brave) ; a renseigner s'il est ailleurs.
BROWSER_EXECUTABLE=
BROWSER_DEBUG_PORT=9333

# ---------------------------------------------------------------------------
# Apify : scraping Instagram / TikTok
# https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_TOKEN=

# Acteurs utilises. Les valeurs par defaut sont les moins cheres constatees.
# Le caractere `~` remplace le `/` dans les URLs Apify.
APIFY_INSTAGRAM_ACTOR=apidojo~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Pinterest n'a pas d'acteur Apify ici : il passe toujours par yt-dlp, qui le
# gere gratuitement et sans session. Rien a configurer.

# ---------------------------------------------------------------------------
# Nano Banana Pro (Google Gemini API)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Modeles de repli, essayes dans l'ordre quand le principal est sature.
# Vide par defaut : mieux vaut attendre Nano Banana Pro qu'obtenir une image
# de moindre qualite (les modeles Flash degradent nettement le rendu).
GEMINI_FALLBACK_MODELS=

# --- Batch API : 50 % du tarif interactif ---
# S'active par job dans l'UI (case "Mode batch"), ou par defaut dans Parametres.
# Requetes par fichier JSONL. Plus petit = resultats partiels plus tot.
GEMINI_BATCH_CHUNK_SIZE=250
GEMINI_BATCH_POLL_INTERVAL=60
GEMINI_BATCH_MAX_WAIT_H=26
# Les images d'entree sont redimensionnees a cette taille avant envoi : divise
# le poids du JSONL par 3 a 5 sans rien changer a ce que le modele percoit.
GEMINI_INPUT_MAX_PX=1280

# ---------------------------------------------------------------------------
# Kling 3.0 Motion Control (API officielle)
#
# Deux schemas possibles selon ta console :
#  (A) Cle unique   : https://kling.ai/dev/api-key -> une seule "API Key".
#                     Renseigne KLING_API_KEY, laisse les deux autres vides.
#  (B) Paire AK/SK  : ancienne Open Platform -> Access Key + Secret Key (JWT).
#                     Renseigne KLING_ACCESS_KEY + KLING_SECRET_KEY.
# Si KLING_API_KEY est renseignee, elle a la priorite.
# ---------------------------------------------------------------------------
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Base internationale. Utiliser https://api.klingai.com pour un serveur en Chine.
KLING_BASE_URL=https://api-singapore.klingai.com

# Chemin de l'endpoint motion control.
# /!\ A confirmer dans la doc de TON compte : ce chemin a change entre versions.
#     L'ecran "Diagnostic" de l'UI teste la joignabilite de cet endpoint.
KLING_MOTION_CONTROL_PATH=/motion-control/kling-3.0
KLING_TASKS_PATH=/tasks
KLING_MODE=pro

# ---------------------------------------------------------------------------
# Acces a l'interface
#
# Le navigateur demande ce mot de passe a la premiere visite. INDISPENSABLE des
# que l'outil est joignable depuis Internet : sans lui, quiconque connait l'URL
# peut lancer des generations et consommer le credit Gemini et Kling.
# Laisser vide desactive la protection (usage strictement local).
#
# La route /public/<jeton>/ reste volontairement ouverte : c'est par elle que
# les serveurs de Kling telechargent les videos. Elle est protegee par le jeton
# secret present dans l'URL.
# ---------------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram : livraison automatique des videos terminees
#
# Chaque video est envoyee des qu'elle sort de Kling, une par une. Laisser vide
# pour desactiver : le pipeline se comporte alors exactement comme avant.
#   - Le token vient de @BotFather.
#   - L'identifiant de conversation s'obtient aupres de @userinfobot.
# Le destinataire doit avoir demarre une conversation avec le bot au moins une
# fois, sinon Telegram refuse l'envoi.
# Plafond impose par Telegram : 50 Mo par video.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Exposition publique des fichiers
# Kling telecharge la video source depuis une URL HTTPS publique.
# ---------------------------------------------------------------------------
# `local` : l'app sert elle-meme les fichiers (necessite PUBLIC_BASE_URL joignable
#           depuis Internet -> le cas sur un VPS).
# `source`: reutilise l'URL CDN d'origine du scraping (gratuit, mais ces URLs
#           sont signees et expirent : a reserver aux traitements immediats).
ASSET_HOST_MODE=local
PUBLIC_BASE_URL=
# Jeton qui protege l'acces public aux fichiers. Genere automatiquement si vide.
ASSET_TOKEN=

# ---------------------------------------------------------------------------
# Garde-fous
# ---------------------------------------------------------------------------
# Plafond de depense par job, en USD. Le pipeline s'arrete net au-dessus.
MAX_SPEND_USD=50

# Aucun appel API payant n'est emis quand DRY_RUN=true.
DRY_RUN=false

# ---------------------------------------------------------------------------
# Concurrence
# ---------------------------------------------------------------------------
CONCURRENCY_DOWNLOAD=4
CONCURRENCY_GEMINI=6
CONCURRENCY_KLING=3

# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
